     "name": "stdout",
     "output_type": "stream",
     "text": [
      "James 18 男\n"
     ]
    }
   ],
   "source": [
    "# 元组的拆包\n",
    "person = ('James', 18, '男')\n",
    "name, age, gender = person\n",
    "print(name, age, gender)"
   ]
  }
