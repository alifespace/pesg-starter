   "source": [
    "# 迭代器是一个对象，是一个能记住当前取到哪里，并且能够继续往下取下一个值的对象\n",
    "# 可迭代对象，是“可以拿来生成迭代器的东西” \n",
    "# 迭代器，是“真正负责一个个吐值的东西”\n",
    "\n",
    "nums = [10, 20,30]\n",
    "it = iter(nums)\n",
    "\n",
    "while True:\n",
    "    try:\n",
    "        n = next(it)\n",
    "        print(n)\n",
    "    except StopIteration:\n",
    "        break\n"
   ]
  }
 ],
