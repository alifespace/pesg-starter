   "source": [
    "## 元组基础\n",
    "\n",
    "元组是一组不可修改的数据，不是所有数据都应该被修改。"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 1,
   "id": "f4615b8b",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "<class 'int'> <class 'tuple'>\n"
     ]
    }
   ],
   "source": [
    "a1 = (10)\n",
    "a2 = (10,)\n",
    "print(type(a1), type(a2)) # <class 'int'>"
   ]
  },
  {
   "cell_type": "code",
