   "source": [
    "## 列表的基础\n",
    "\n",
    "1. 列表是一种 python 提供的数据容器。列表就是用一个变量，保存一组有顺序的数据。\n",
    "2. 列表可以存放常见的数据类型：整数、浮点数、布尔值、混合数据类型；"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 2,
   "id": "d5796737",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "['孙悟空', '猪八戒', '沙和尚'] <class 'list'>\n",
      "孙悟空\n",
      "猪八戒\n",
      "沙和尚\n"
     ]
    }
   ],
   "source": [
    "names = ['孙悟空', '猪八戒', '沙和尚']\n",
    "print(names, type(names))\n",
    "for name in names:\n",
    "    print(name)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 3,
   "id": "2b849f1b",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "第1位取经者是：孙悟空\n",
      "第2位取经者是：猪八戒\n",
      "第3位取经者是：沙和尚\n"
     ]
    }
   ],
   "source": [
    "count = 1\n",
    "for name in names:\n",
    "    print(f'第{count}位取经者是：{name}')\n",
    "    count += 1"
   ]
  }
